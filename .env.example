# HR Attendance Copilot - Root Environment Example
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
DATABASE_URL=sqlite:///./hr_attendance.db
JWT_SECRET_KEY=change-this-secret-in-production-environment-min-32-chars
JWT_EXPIRE_MINUTES=480
ALLOW_MANAGER_EMPLOYEE_READ=true
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash
